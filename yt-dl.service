[Unit]
Description=YouTube Downloader Docker Compose Service (GPU-enabled)
Requires=docker.service
After=docker.service network.target
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/yt-downloader
# Use Docker Compose plugin and include the GPU override file
ExecStart=/usr/bin/docker compose -f /opt/yt-downloader/docker-compose.yml -f /opt/yt-downloader/docker-compose.gpu.yml up -d
ExecStop=/usr/bin/docker compose -f /opt/yt-downloader/docker-compose.yml -f /opt/yt-downloader/docker-compose.gpu.yml down
ExecReload=/usr/bin/docker compose -f /opt/yt-downloader/docker-compose.yml -f /opt/yt-downloader/docker-compose.gpu.yml restart
TimeoutStartSec=300
TimeoutStopSec=60

# Environment (enable GPU)
Environment=COMPOSE_PROJECT_NAME=yt-downloader
Environment=APP_PORT=80
Environment=APP_USE_GPU=1
Environment=APP_GPU_DEVICE=0

# Run as the yt-dl user; grant Docker group access for socket permissions
User=yt-dl
Group=yt-dl
SupplementaryGroups=docker

# Restart policy
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target